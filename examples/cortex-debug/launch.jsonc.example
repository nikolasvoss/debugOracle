{
  "version": "0.2.0",
  "configurations": [
    {
      // This example is specific to an STM32 + OpenOCD workflow.
      // Adjust the target, executable, and debugger paths for your project.
      "name": "Debug STM32 (OpenOCD)",
      "type": "cortex-debug",
      "request": "launch",
      "showDevDebugOutput": "raw",
      "servertype": "openocd",
      "overrideGDBServerStartedRegex": "Info\\s*:\\s*Listening on port\\s+\\d+\\s+for\\s+gdb\\s+connections?",
      // PATH-based tool lookup is used by default.
      // Set these only when your environment needs fixed binaries:
      // "armToolchainPath": "${env:HOME}/.local/toolchains/arm-none-eabi/bin",
      // "gdbPath": "${env:HOME}/.local/toolchains/arm-none-eabi/bin/arm-none-eabi-gdb",

      // Optional advanced override only (not shipped by default):
      // "serverpath": "/absolute/path/to/openocd-wrapper.sh",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32l4x.cfg"
      ],
      "openOCDLaunchCommands": [
        "adapter speed 4000"
      ],
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/app.elf",
      "runToEntryPoint": "main",
      "preLaunchTask": "Prepare debug logs",

      // Write MI log directly into .dbgoracle for DebugOracle.
      "sharedMiLogFile": "${workspaceFolder}/.dbgoracle/cortex-debug-shared-mi.log",
      "preLaunchCommands": [
        "set pagination off",
        "set logging overwrite on",
        "set logging file ${workspaceFolder}/.dbgoracle/cortex-debug-shared-mi.log",
        "set logging on"
      ],
      "postLaunchCommands": [
        "set remotetimeout 20",
        "monitor reset halt",
        "set pagination off"
      ],

      // Optional: if your GDB supports Python and you want richer dumps, add:
      // "source .vscode/dump-registers.gdb" to postLaunchCommands.
      // This repo avoids Python-only post-launch scripts by default for compatibility.
      "rttConfig": {
        "enabled": true,
        "address": "auto",
        "clearSearch": false,
        "searchId": "SEGGER RTT",
        "rtt_start_retry": 5000,
        "polling_interval": 10,
        "decoders": [
          {
            "label": "RTT",
            "type": "console",
            "port": 0,
            "logFile": "${workspaceFolder}/.dbgoracle/session.rtt",
            "timestamp": true
          }
        ]
      }
    }
  ]
}
