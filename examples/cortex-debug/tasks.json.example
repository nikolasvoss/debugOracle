{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DebugOracle: Prelaunch",
      "dependsOn": [
        "Prepare debug logs",
        "Start RTT capture"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Prepare debug logs",
      "type": "shell",
      "command": "mkdir -p \"${workspaceFolder}/.dbgoracle\" && : > \"${workspaceFolder}/.dbgoracle/cortex-debug-shared-mi.log\" && : > \"${workspaceFolder}/.dbgoracle/session.rtt\" && rm -f \"${workspaceFolder}/.dbgoracle/session.rtt.state.json\"",
      "windows": {
        "command": "New-Item -ItemType Directory -Force -Path \"${workspaceFolder}\\\\.dbgoracle\" | Out-Null; New-Item -ItemType File -Force -Path \"${workspaceFolder}\\\\.dbgoracle\\\\cortex-debug-shared-mi.log\" | Out-Null; New-Item -ItemType File -Force -Path \"${workspaceFolder}\\\\.dbgoracle\\\\session.rtt\" | Out-Null; Remove-Item -ErrorAction SilentlyContinue \"${workspaceFolder}\\\\.dbgoracle\\\\session.rtt.state.json\""
      },
      "problemMatcher": []
    },
    {
      "label": "Start RTT capture",
      "type": "shell",
      "command": "bash -lc 'set -e\nmkdir -p \"${workspaceFolder}/.dbgoracle\"\npidfile=\"${workspaceFolder}/.dbgoracle/session.rtt.pid\"\nlogfile=\"${workspaceFolder}/.dbgoracle/session.rtt.launch.log\"\nstatefile=\"${workspaceFolder}/.dbgoracle/session.rtt.state.json\"\noutfile=\"${workspaceFolder}/.dbgoracle/session.rtt\"\nrm -f \"$pidfile\"\n\nif [ -x \"${workspaceFolder}/dbgoracle\" ]; then\n  dbgoracle_bin=\"${workspaceFolder}/dbgoracle\"\nelif command -v dbgoracle >/dev/null 2>&1; then\n  dbgoracle_bin=\"$(command -v dbgoracle)\"\nelse\n  echo \"dbgoracle not found in workspace or PATH\" >> \"$logfile\"\n  exit 127\nfi\n\nif command -v setsid >/dev/null 2>&1; then\n  setsid nohup \"$dbgoracle_bin\" capture-rtt --port 60001 --output \"$outfile\" --state-out \"$statefile\" >> \"$logfile\" 2>&1 < /dev/null &\nelse\n  nohup \"$dbgoracle_bin\" capture-rtt --port 60001 --output \"$outfile\" --state-out \"$statefile\" >> \"$logfile\" 2>&1 < /dev/null &\nfi\nprintf \"%s\\n\" \"$!\" > \"$pidfile\"'",
      "windows": {
        "command": "powershell -NoProfile -Command \"Write-Host 'RTT auto-capture is POSIX-only. Start ./dbgoracle capture-rtt manually if needed.'\""
      },
      "problemMatcher": []
    },
    {
      "label": "Stop RTT capture",
      "type": "shell",
      "command": "bash -lc 'pidfile=\"${workspaceFolder}/.dbgoracle/session.rtt.pid\"; if [ -f \"$pidfile\" ]; then pid=$(cat \"$pidfile\" || true); if [ -n \"$pid\" ] && kill -0 \"$pid\" 2>/dev/null; then kill \"$pid\" || true; fi; rm -f \"$pidfile\"; fi'",
      "problemMatcher": []
    }
  ]
}
