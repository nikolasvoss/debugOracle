{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DebugOracle: Prelaunch",
      "dependsOn": [
        "Prepare debug logs",
        "DebugOracle: Start RTT run"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Prepare debug logs",
      "type": "shell",
      "command": "mkdir -p \"${workspaceFolder}/.dbgoracle\" && : > \"${workspaceFolder}/.dbgoracle/cortex-debug-shared-mi.log\" && : > \"${workspaceFolder}/.dbgoracle/session.rtt\" && : > \"${workspaceFolder}/.dbgoracle/session.rtt.launch.log\" && rm -f \"${workspaceFolder}/.dbgoracle/session.rtt.state.json\"",
      "windows": {
        "command": "New-Item -ItemType Directory -Force -Path \"${workspaceFolder}\\\\.dbgoracle\" | Out-Null; New-Item -ItemType File -Force -Path \"${workspaceFolder}\\\\.dbgoracle\\\\cortex-debug-shared-mi.log\" | Out-Null; New-Item -ItemType File -Force -Path \"${workspaceFolder}\\\\.dbgoracle\\\\session.rtt\" | Out-Null; New-Item -ItemType File -Force -Path \"${workspaceFolder}\\\\.dbgoracle\\\\session.rtt.launch.log\" | Out-Null; Remove-Item -ErrorAction SilentlyContinue \"${workspaceFolder}\\\\.dbgoracle\\\\session.rtt.state.json\""
      },
      "problemMatcher": []
    },
    {
      "label": "DebugOracle: Start RTT run",
      "detail": "Required per-project edits: keep --port aligned with the RTT server port in launch.jsonc, and increase --connect-timeout further if your debugger/server startup is slow.",
      "type": "shell",
      "command": "dbgoracle run --detach --workspace-root \"${workspaceFolder}\" --port 60001 --connect-timeout 30 --output \"${workspaceFolder}/.dbgoracle/session.rtt\" --state-out \"${workspaceFolder}/.dbgoracle/session.rtt.state.json\"",
      "windows": {
        "command": "dbgoracle run --detach --workspace-root \"${workspaceFolder}\" --port 60001 --connect-timeout 30 --output \"${workspaceFolder}\\\\.dbgoracle\\\\session.rtt\" --state-out \"${workspaceFolder}\\\\.dbgoracle\\\\session.rtt.state.json\""
      },
      "problemMatcher": []
    },
    {
      "label": "DebugOracle: Stop RTT run",
      "type": "shell",
      "command": "dbgoracle stop --workspace-root \"${workspaceFolder}\"",
      "windows": {
        "command": "dbgoracle stop --workspace-root \"${workspaceFolder}\""
      },
      "problemMatcher": []
    }
  ]
}
